# Production env (set these in Coolify). Locally docker-compose.yml points SMTP at Mailpit.
NUXT_SITE_URL=https://medirefined.example
NUXT_PUBLIC_SITE_INDEXABLE=false   # true at launch

# Booking-form email (SMTP). NUXT_SMTP_SECURE=true only for port 465.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_MAIL_FROM=MediRefined <noreply@medirefined.example>
NUXT_FORM_NOTIFY=clinic@medirefined.example   # comma-separated staff recipients
